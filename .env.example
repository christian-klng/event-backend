# Generate both secrets with: openssl rand -base64 48
ADMIN_TOKEN=
APP_SECRET=

# Public URL of this service, used for thumbnail and upload links
PUBLIC_BASE_URL=http://localhost:3000

# Postgres in production. Without a value, local development uses an embedded database in .data/
# DATABASE_URL=postgres://user:password@host:5432/events

PORT=3000

# Optional. Secrets set here win over the ones stored through MCP.
# SMTP_PASSWORD=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
